Cell[BoxData[
 ButtonBox["\<\"Calculate\"\>",
  Appearance->Automatic,
  ButtonFunction:>($CellContext`expr = $CellContext`a 
      Tanh[$CellContext`b $CellContext`ii] + $CellContext`c; $CellContext`nlm = 
    NonlinearModelFit[
      Transpose[{
        Range[
         Length[$CellContext`runningBest]], $CellContext`runningBest}], \
$CellContext`expr, {{$CellContext`a, 
        Max[$CellContext`runningBest]}, {$CellContext`b, 1/
        Length[$CellContext`runningBest]}, {$CellContext`c, 
        Min[$CellContext`runningBest]}}, $CellContext`ii, Method -> 
      "NMinimize"]; $CellContext`meanPredictionBands = $CellContext`nlm[
     "MeanPredictionBands"]; $CellContext`singlePredictionBands = \
$CellContext`nlm["SinglePredictionBands"]; $CellContext`plotMe = Join[
      Join[{
        $CellContext`nlm[
        "BestFit"]}, $CellContext`meanPredictionBands], \
$CellContext`singlePredictionBands]; $CellContext`img = Show[
      ListPlot[
       Transpose[{
         Range[
          Length[$CellContext`runningBest]], $CellContext`runningBest}], 
       PlotRange -> {{0, Length[$CellContext`runningBest] 1.5}, {
         0, Max[$CellContext`runningBest] 1.5}}, ImageSize -> 800], 
      Plot[$CellContext`plotMe, {$CellContext`ii, 0, 
        Length[$CellContext`runningBest] 1.5}, PlotStyle -> {{
          Opacity[0.5], Black}, {
          Opacity[0.5], Red}, {
          Opacity[0.5], Red}, {
          Opacity[0.5], Green}, {
          Opacity[0.5], Green}}, PlotRange -> All]]; 
   Print["Estimated limits: ", 
     Sort[
      Map[Limit[#, $CellContext`ii -> Infinity]& , $CellContext`plotMe]]]; 
   Print[$CellContext`img]; Null),
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
