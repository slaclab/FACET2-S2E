          RowBox[{"b", ",", 
           RowBox[{"1", "/", 
            RowBox[{"Length", "[", "runningBest", "]"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"Min", "[", "runningBest", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", "ii", ",", 
