    "\[IndentingNewLine]", 
    RowBox[{"nlm", "=", 
     RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
