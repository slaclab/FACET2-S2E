Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "block", " ", "can", " ", "get", " ", "really", " ", "slow", 
     " ", "for", " ", "large", " ", "numbers", " ", "of", " ", 
     "simulations"}], ";", " ", 
    RowBox[{
    "pare", " ", "down", " ", "number", " ", "of", " ", "points", " ", "to", " ",
      "plot"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"shotCount", " ", "=", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"raw", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"indicesToPlot", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Round", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "shotCount", ",", 
         RowBox[{"shotCount", "/", "1000"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
