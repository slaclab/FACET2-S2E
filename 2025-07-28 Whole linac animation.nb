Cell[BoxData[
 RowBox[{
  RowBox[{"zAssoc", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"tmp", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"\"\<~/tmpSLACData/beamData_\>\"", "<>", 
         RowBox[{"Hash", "[", 
          RowBox[{
          "key", ",", "\"\<Expression\>\"", ",", "\"\<HexString\>\""}], "]"}],
          "<>", "\"\<.mx\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"key", "->", 
       RowBox[{"tmp", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"key", ",", 
       RowBox[{"allKeyPrefixes", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"-", "1"}], ";;", "1"}], "]"}], "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.927997397651976*^9, 3.927997478680914*^9}, {
   3.927997518885549*^9, 3.9279975414122*^9}, 3.927998372063788*^9, {
