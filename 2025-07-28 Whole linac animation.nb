Cell[BoxData[
 RowBox[{
  RowBox[{"getRegionString", "[", "zActual_", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"Length", "[", "beamlinePositions", "]"}]}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"zActual", ">", 
        RowBox[{"beamlinePositions", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "i"}], ",", "2"}], "]"}], "]"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"beamlinePositions", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "i"}], ",", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.928002582434061*^9, 3.928002686379211*^9}, {
  3.928002723793243*^9, 3.928002737444482*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"31ba0ced-783e-4571-acb9-2abb60c62115"],

