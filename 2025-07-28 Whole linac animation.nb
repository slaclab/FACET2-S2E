Cell[BoxData[
 RowBox[{
  RowBox[{"makeLabel", "[", "dumpedS_", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zActual", " ", "=", " ", 
     RowBox[{"dumpedS", " ", "+", " ", "4.127"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"Dumping", " ", "starts", " ", "at", " ", "L0AFEND"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"outputString", " ", "=", " ", 
     RowBox[{"getRegionString", "[", "zActual", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"outputString", " ", "=", " ", 
     RowBox[{"outputString", "<>", "\"\<: z = \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"Round", "[", 
        RowBox[{"zActual", ",", "0.1"}], "]"}], "]"}], 
      "<>", "\"\<, \!\(\*SubscriptBox[\(E\), \(0\)]\) = \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"1*^-9", 
          RowBox[{"momentumInterp", "[", "dumpedS", "]"}]}], ",", "0.1"}], 
        "]"}], "]"}], "<>", "\"\< GeV\>\""}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Style", "[", 
     RowBox[{"outputString", ",", "50", ",", 
      RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.928002826038905*^9, 3.928002875113535*^9}, {
