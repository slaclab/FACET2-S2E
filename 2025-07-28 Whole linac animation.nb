Cell[BoxData[
 RowBox[{
  RowBox[{"zAssocInverse", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Values", "[", "zAssoc", "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}], "->", 
       RowBox[{
        RowBox[{"Keys", "[", "zAssoc", "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "zAssoc", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], "//", "Association"}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"556657e6-f035-40d7-8ee6-9d872a839dbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Try", " ", "to", " ", 
    RowBox[{"pick", " ", "~", "equally"}], " ", "spaced", " ", "points", " ", 
    "instead", " ", "of", " ", "every", " ", "element"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"selectedKeysForFrames", " ", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Nearest", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Keys", "[", "zAssocInverse", "]"}], ",", 
          "\[IndentingNewLine]", "zDesired"}], "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"zDesired", ",", 
         RowBox[{
          RowBox[{"Keys", "[", "zAssocInverse", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Keys", "[", "zAssocInverse", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], ",", "1"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selectedKeysForFrames", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"zAssocInverse", "[", "#", "]"}], "&"}], "/@", 
      "selectedKeysForFrames"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9280616053494062`*^9, 3.928061607234888*^9}, {
   3.928061732900648*^9, 3.9280617677551117`*^9}, 3.928061843175861*^9, {
