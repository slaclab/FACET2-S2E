Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"momentumInterp", "=", " ", 
  RowBox[{"Interpolation", "[", 
   RowBox[{
    RowBox[{"DeleteDuplicatesBy", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"zAssoc", "[", "#", "]"}], ",", 
          RowBox[{"momentumAssoc", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Keys", "[", "zAssoc", "]"}]}], ",", "First"}], "]"}], ",", 
    RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.92806101231545*^9, 3.928061047007516*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"95cf0c1d-4e45-4d62-83f1-00a7b0232a70"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["InterpolatingFunction",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{{{{}, {}, 
                TagBox[{
                  Directive[
